#!/bin/bash

# Launch the Omarchy screensaver on each monitor using the active user/theme
# omarchy-screensaver binary (bypassing Ghostty single-instance login PATH).

pgrep -f '[o]rg.omarchy.screensaver' >/dev/null && exit 0

if omarchy-toggle-enabled screensaver-off && [[ ${1:-} != "force" ]]; then
  exit 1
fi

focused=$(omarchy-hyprland-monitor-focused)
terminal=$(xdg-terminal-exec --print-id)

case $terminal in
*Alacritty* | *ghostty* | *foot* | *kitty*) ;;
*)
  omarchy-notification-send -g ✋ "Screensaver only runs in Alacritty, Foot, Ghostty, or Kitty"
  exit 1
  ;;
esac

SCREENSAVER_BIN="$HOME/.local/bin/omarchy-screensaver"
if [[ ! -x $SCREENSAVER_BIN ]]; then
  SCREENSAVER_BIN=$(command -v omarchy-screensaver)
fi

hypr_focus_monitor() {
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$1\" })" >/dev/null 2>&1 || hyprctl dispatch focusmonitor "$1" >/dev/null
}

hypr_exec() {
  local command
  printf -v command '%q ' "$@"

  hyprctl dispatch "hl.dsp.exec_cmd([[$command]])" >/dev/null 2>&1 || hyprctl dispatch exec -- bash -lc "$command" >/dev/null
}

SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

exec {events}< <(socat -U - "UNIX-CONNECT:$SOCKET" 2>/dev/null)

wait_for_screensaver_window() {
  local line deadline=$((SECONDS + 5))
  while ((SECONDS < deadline)) && IFS= read -r -t $((deadline - SECONDS)) -u "$events" line; do
    [[ $line == openwindow\>\>*,org.omarchy.screensaver,* ]] && return 0
  done
}

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hypr_focus_monitor "$m"

  case $terminal in
  *Alacritty*)
    hypr_exec alacritty --class=org.omarchy.screensaver --config-file "$OMARCHY_PATH/default/alacritty/screensaver.toml" -e "$SCREENSAVER_BIN"
    ;;
  *ghostty*)
    hypr_exec ghostty --class=org.omarchy.screensaver --config-file="$OMARCHY_PATH/default/ghostty/screensaver" --font-size=18 -e "$SCREENSAVER_BIN"
    ;;
  *foot*)
    hypr_exec foot --app-id=org.omarchy.screensaver --config="$OMARCHY_PATH/default/foot/screensaver.ini" -e "$SCREENSAVER_BIN"
    ;;
  *kitty*)
    hypr_exec kitty --class=org.omarchy.screensaver --override font_size=18 --override window_padding_width=0 -e "$SCREENSAVER_BIN"
    ;;
  esac

  wait_for_screensaver_window
done

exec {events}<&-
hypr_focus_monitor "$focused"
